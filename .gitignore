# redistributed, and neither is anything mined from it.
data/

# The Bakos mining pipeline: OCR output, intermediate text, extracted entries
# and the local OCR toolchain. All derived from a copyrighted dictionary, so
# none of it belongs in the repository.
data_collection_and_verification/
